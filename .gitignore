/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs

# pi agent harness local artifacts (memory/plan files + telemetry)
.agent/
/PLAN.md
/TASKS.md
/PROGRESS.md

# whisper dictation engine: committed Windows binaries, downloaded models, build cache
/whisper/bin/*
!/whisper/bin/whisper-server.exe
!/whisper/bin/whisper.dll
!/whisper/bin/ggml.dll
!/whisper/bin/ggml-base.dll
!/whisper/bin/ggml-cpu.dll
/whisper/models/
/whisper/build/

# piper TTS engine: venv + downloaded voices
/piper/

# throwaway voice test artifacts
/.ks/

